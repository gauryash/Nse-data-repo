# `.env` environment variables template.
# Copy to .env and fill in your values.

# === NSE Data Provider ===
NSE_DATA_FOLDER=data
NSE_DEFAULT_INDEX=nifty500
NSE_FETCH_START=01-01-2021
NSE_FETCH_END=23-05-2026
NSE_FETCH_CHUNK_DAYS=110
NSE_RATE_MAX_WORKERS=5
NSE_RATE_INITIAL_DELAY=0.5
NSE_RATE_MAX_DELAY=30.0
NSE_RATE_BACKOFF_FACTOR=2.0
NSE_FETCH_MAX_RETRIES=5
NSE_FETCH_SLEEP=0.1
NSE_STORAGE_FORMAT=parquet    # parquet | csv
NSE_LOG_LEVEL=INFO
# NSE index CSV base URLs (useful if NSE changes CDN domain)
# NSE_INDEX_CSV_BASE=https://nsearchives.nseindia.com/content/indices
# NIFTYINDICES_BASE=https://www.niftyindices.com/IndexConstituent

# === Upstox Data Provider ===
UPSTOX_INTERVAL=month          # day | week | month
UPSTOX_MAX_WORKERS=10
UPSTOX_CHUNK_YEARS=5
UPSTOX_FETCH_START=01-01-2000
# UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
UPSTOX_INSTRUMENTS_CACHE_TTL_HOURS=12

# === Upstox Options (F&O) ===
UPSTOX_OPTIONS_INTERVAL=day    # day | week | month
UPSTOX_OPTIONS_MAX_WORKERS=5
UPSTOX_OPTIONS_CHUNK_YEARS=2
UPSTOX_OPTIONS_FETCH_START=01-01-2024
UPSTOX_OPTIONS_TYPES=OPTSTK    # OPTSTK, OPTIDX (comma-separated)
UPSTOX_OPTIONS_N_EXPIRIES=2    # 0 = all expiries
UPSTOX_OPTIONS_INDEX_NAMES=NIFTY,BANKNIFTY  # restrict index options
