# `.env` environment variables template.
# Copy to .env and fill in your values.

# === Telegram (required for scanners) ===
BOT_TOKEN=
CHAT_ID_ALERT=
CHAT_ID_BOT=

# === NSE Data Provider ===
NSE_DATA_FOLDER=data
NSE_DEFAULT_INDEX=nifty500
# NSE API returns at most 70 records per call (~100 trading days).
# Set start date early enough to collect sufficient data for RS (need 50+ weekly rows).
# chunk_days=110 ensures each API call captures all records in the window.
NSE_FETCH_START=01-01-2021
NSE_FETCH_END=23-05-2026
NSE_FETCH_CHUNK_DAYS=110
NSE_RS_LOOKBACK=50
NSE_RATE_MAX_WORKERS=5
NSE_RATE_INITIAL_DELAY=0.5
NSE_RATE_MAX_DELAY=30.0
NSE_RATE_BACKOFF_FACTOR=2.0
NSE_FETCH_MAX_RETRIES=5
NSE_FETCH_SLEEP=0.1
NSE_STORAGE_FORMAT=parquet    # parquet | csv
NSE_LOG_LEVEL=INFO

# === Upstox Data Provider ===
UPSTOX_INTERVAL=month          # day | week | month
UPSTOX_MAX_WORKERS=10
UPSTOX_CHUNK_YEARS=5
UPSTOX_FETCH_START=01-01-2000 # fetch start date for Upstox

# === Alpha Pipeline (12-step signal processing) ===
NSE_ALPHA_LOOKBACK=252   # M: lookback periods (default: 252 ≈ 1 trading year)
NSE_ALPHA_ESTIMATION=20  # d: estimation periods (default: 20 ≈ 1 trading month)
NSE_ALPHA_ETA=1.0        # η: weighting scale

# For details, see docs/alpha_pipeline.md
