# Virtual environment
venv/

# Environment variables (secrets)
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# Packaging
*.egg-info/
dist/
build/
.eggs/

# Data output files (generated by pipeline/analytics)
data/*.parquet
data/*.csv
data/nse/*.parquet
data/nse/*.csv
data/upstox/*.parquet
data/upstox/*.csv
data/*.xlsx
data/parquet/*.parquet

# Checkpoint files (auto-generated, per-provider metadata)
data/**/_checkpoint.json

# Generated analysis output files
analysis/*.csv
analysis/*.txt
analysis/rankings/
analysis_test/
*.ranking.csv
*_ranking.csv  # e.g. alpha_ranking.csv

*.csv
*.txt
*.xlsx
*.parquet

# Keep directory structure
!data/nse/.gitkeep 2>/dev/null || true
!data/upstox/.gitkeep 2>/dev/null || true

# IDE
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Archive (old code snapshot)
archive/
